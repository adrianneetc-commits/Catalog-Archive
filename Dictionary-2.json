{"Date Created":"Jun 1, 2026 at 10:26 PM","Tool Type":"HTML","AI Webpage":"","Title":"Gemini → Markdown","Dependencies":[],"Description":"","HTML Data":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>Gemini → Markdown<\/title>\n<link href=\"https:\/\/fonts.googleapis.com\/css2?family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Syne:wght@400;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root {\n    --bg: #0a0a0f;\n    --surface: #111118;\n    --surface2: #1a1a24;\n    --border: #2a2a3a;\n    --accent: #4f8ef7;\n    --accent2: #a78bfa;\n    --success: #34d399;\n    --warn: #fbbf24;\n    --danger: #f87171;\n    --text: #e8e8f0;\n    --muted: #6b6b88;\n    --mono: 'Space Mono', monospace;\n    --sans: 'Syne', sans-serif;\n  }\n\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n\n  body {\n    background: var(--bg);\n    color: var(--text);\n    font-family: var(--sans);\n    min-height: 100vh;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 40px 20px 80px;\n    position: relative;\n    overflow-x: hidden;\n  }\n\n  \/* Background grid *\/\n  body::before {\n    content: '';\n    position: fixed;\n    inset: 0;\n    background-image:\n      linear-gradient(rgba(79,142,247,0.04) 1px, transparent 1px),\n      linear-gradient(90deg, rgba(79,142,247,0.04) 1px, transparent 1px);\n    background-size: 40px 40px;\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  \/* Ambient glow *\/\n  body::after {\n    content: '';\n    position: fixed;\n    top: -200px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(79,142,247,0.08) 0%, transparent 70%);\n    pointer-events: none;\n    z-index: 0;\n  }\n\n  .container {\n    width: 100%;\n    max-width: 760px;\n    position: relative;\n    z-index: 1;\n  }\n\n  header {\n    text-align: center;\n    margin-bottom: 48px;\n    animation: fadeUp 0.6s ease both;\n  }\n\n  .logo-row {\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    margin-bottom: 12px;\n  }\n\n  .logo-icon {\n    width: 36px;\n    height: 36px;\n    background: linear-gradient(135deg, var(--accent), var(--accent2));\n    border-radius: 8px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n  }\n\n  h1 {\n    font-size: clamp(28px, 6vw, 42px);\n    font-weight: 800;\n    letter-spacing: -0.03em;\n    background: linear-gradient(120deg, #fff 30%, var(--accent2));\n    -webkit-background-clip: text;\n    -webkit-text-fill-color: transparent;\n    background-clip: text;\n  }\n\n  .subtitle {\n    font-family: var(--mono);\n    font-size: 13px;\n    color: var(--muted);\n    letter-spacing: 0.05em;\n    margin-top: 6px;\n  }\n\n  \/* Input card *\/\n  .card {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 16px;\n    padding: 28px;\n    margin-bottom: 20px;\n    animation: fadeUp 0.6s ease 0.1s both;\n  }\n\n  .field-label {\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--muted);\n    letter-spacing: 0.12em;\n    text-transform: uppercase;\n    margin-bottom: 10px;\n    display: flex;\n    align-items: center;\n    gap: 6px;\n  }\n\n  .field-label::before {\n    content: '';\n    display: inline-block;\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: var(--accent);\n  }\n\n  .url-row {\n    display: flex;\n    gap: 10px;\n  }\n\n  input[type=\"text\"] {\n    flex: 1;\n    background: var(--surface2);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    padding: 13px 16px;\n    color: var(--text);\n    font-family: var(--mono);\n    font-size: 13px;\n    outline: none;\n    transition: border-color 0.2s, box-shadow 0.2s;\n  }\n\n  input[type=\"text\"]:focus {\n    border-color: var(--accent);\n    box-shadow: 0 0 0 3px rgba(79,142,247,0.12);\n  }\n\n  input[type=\"text\"]::placeholder { color: var(--muted); }\n\n  .btn {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 13px 22px;\n    border-radius: 10px;\n    font-family: var(--sans);\n    font-size: 14px;\n    font-weight: 700;\n    cursor: pointer;\n    border: none;\n    transition: all 0.2s;\n    white-space: nowrap;\n  }\n\n  .btn-primary {\n    background: linear-gradient(135deg, var(--accent), #3b6fd4);\n    color: #fff;\n    box-shadow: 0 4px 20px rgba(79,142,247,0.3);\n  }\n\n  .btn-primary:hover {\n    transform: translateY(-1px);\n    box-shadow: 0 6px 28px rgba(79,142,247,0.45);\n  }\n\n  .btn-primary:active { transform: translateY(0); }\n  .btn-primary:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }\n\n  .btn-secondary {\n    background: var(--surface2);\n    color: var(--text);\n    border: 1px solid var(--border);\n  }\n\n  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); }\n\n  \/* Options *\/\n  .options-row {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 8px;\n    margin-top: 18px;\n    padding-top: 18px;\n    border-top: 1px solid var(--border);\n  }\n\n  .toggle-chip {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    padding: 6px 12px;\n    background: var(--surface2);\n    border: 1px solid var(--border);\n    border-radius: 100px;\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--muted);\n    cursor: pointer;\n    transition: all 0.2s;\n    user-select: none;\n  }\n\n  .toggle-chip input { display: none; }\n\n  .toggle-chip:has(input:checked) {\n    border-color: var(--accent);\n    color: var(--accent);\n    background: rgba(79,142,247,0.08);\n  }\n\n  .toggle-dot {\n    width: 6px;\n    height: 6px;\n    border-radius: 50%;\n    background: currentColor;\n    opacity: 0.5;\n  }\n\n  .toggle-chip:has(input:checked) .toggle-dot { opacity: 1; }\n\n  \/* Status bar *\/\n  .status-bar {\n    display: none;\n    align-items: center;\n    gap: 12px;\n    padding: 14px 20px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 10px;\n    margin-bottom: 20px;\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--muted);\n    animation: fadeUp 0.3s ease both;\n  }\n\n  .status-bar.active { display: flex; }\n\n  .spinner {\n    width: 16px;\n    height: 16px;\n    border: 2px solid var(--border);\n    border-top-color: var(--accent);\n    border-radius: 50%;\n    animation: spin 0.7s linear infinite;\n    flex-shrink: 0;\n  }\n\n  .status-text { flex: 1; }\n  .status-step { color: var(--accent); font-weight: 700; }\n\n  \/* Stats row *\/\n  .stats-row {\n    display: none;\n    gap: 12px;\n    margin-bottom: 20px;\n    animation: fadeUp 0.3s ease both;\n  }\n\n  .stats-row.active { display: flex; flex-wrap: wrap; }\n\n  .stat-chip {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    padding: 8px 14px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 8px;\n    font-family: var(--mono);\n    font-size: 12px;\n  }\n\n  .stat-num { color: var(--accent); font-weight: 700; }\n  .stat-label { color: var(--muted); }\n\n  \/* Output *\/\n  .output-card {\n    display: none;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 16px;\n    overflow: hidden;\n    animation: fadeUp 0.4s ease both;\n  }\n\n  .output-card.active { display: block; }\n\n  .output-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 20px;\n    border-bottom: 1px solid var(--border);\n    background: var(--surface2);\n  }\n\n  .output-title {\n    font-family: var(--mono);\n    font-size: 12px;\n    color: var(--muted);\n    letter-spacing: 0.08em;\n  }\n\n  .output-actions { display: flex; gap: 8px; }\n\n  textarea {\n    width: 100%;\n    min-height: 480px;\n    background: transparent;\n    border: none;\n    padding: 20px;\n    color: var(--text);\n    font-family: var(--mono);\n    font-size: 13px;\n    line-height: 1.7;\n    resize: vertical;\n    outline: none;\n  }\n\n  \/* Error *\/\n  .error-box {\n    display: none;\n    padding: 16px 20px;\n    background: rgba(248,113,113,0.08);\n    border: 1px solid rgba(248,113,113,0.3);\n    border-radius: 10px;\n    font-family: var(--mono);\n    font-size: 13px;\n    color: var(--danger);\n    margin-bottom: 20px;\n    animation: fadeUp 0.3s ease both;\n  }\n\n  .error-box.active { display: block; }\n\n  \/* Proxy notice *\/\n  .notice {\n    padding: 14px 18px;\n    background: rgba(251,191,36,0.06);\n    border: 1px solid rgba(251,191,36,0.2);\n    border-radius: 10px;\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--warn);\n    line-height: 1.6;\n    margin-bottom: 20px;\n    animation: fadeUp 0.6s ease 0.2s both;\n  }\n\n  .notice strong { color: #fcd34d; }\n\n  \/* How it works *\/\n  .steps {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));\n    gap: 12px;\n    margin-top: 40px;\n    animation: fadeUp 0.6s ease 0.3s both;\n  }\n\n  .step {\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: 12px;\n    padding: 18px;\n  }\n\n  .step-num {\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--accent);\n    letter-spacing: 0.1em;\n    margin-bottom: 8px;\n  }\n\n  .step-title {\n    font-weight: 700;\n    font-size: 14px;\n    margin-bottom: 4px;\n  }\n\n  .step-desc {\n    font-family: var(--mono);\n    font-size: 11px;\n    color: var(--muted);\n    line-height: 1.6;\n  }\n\n  @keyframes fadeUp {\n    from { opacity: 0; transform: translateY(12px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n\n  @keyframes spin {\n    to { transform: rotate(360deg); }\n  }\n\n  .copy-flash {\n    color: var(--success) !important;\n    border-color: var(--success) !important;\n  }\n<\/style>\n<\/head>\n<body>\n<div class=\"container\">\n\n  <header>\n    <div class=\"logo-row\">\n      <div class=\"logo-icon\">✦<\/div>\n      <h1>Gemini → MD<\/h1>\n    <\/div>\n    <p class=\"subtitle\">\/\/ shared conversation converter<\/p>\n  <\/header>\n\n  <div class=\"notice\">\n    <strong>⚠ CORS Note:<\/strong> Browsers block direct fetches to gemini.google.com. This tool uses a public CORS proxy (<code>api.allorigins.win<\/code>) to fetch shared links. For production use, run the Node.js version locally or use your own proxy.\n  <\/div>\n\n  <div class=\"card\">\n    <div class=\"field-label\">Gemini Share URL<\/div>\n    <div class=\"url-row\">\n      <input type=\"text\" id=\"urlInput\" placeholder=\"https:\/\/gemini.google.com\/share\/...\" autocomplete=\"off\" spellcheck=\"false\">\n      <button class=\"btn btn-primary\" id=\"convertBtn\" onclick=\"convert()\">\n        <span>⚡<\/span> Convert\n      <\/button>\n    <\/div>\n\n    <div class=\"options-row\">\n      <label class=\"toggle-chip\">\n        <input type=\"checkbox\" id=\"optCode\" checked>\n        <span class=\"toggle-dot\"><\/span> Code blocks\n      <\/label>\n      <label class=\"toggle-chip\">\n        <input type=\"checkbox\" id=\"optInline\" checked>\n        <span class=\"toggle-dot\"><\/span> Inline code\n      <\/label>\n      <label class=\"toggle-chip\">\n        <input type=\"checkbox\" id=\"optTables\" checked>\n        <span class=\"toggle-dot\"><\/span> Tables\n      <\/label>\n      <label class=\"toggle-chip\">\n        <input type=\"checkbox\" id=\"optLang\" checked>\n        <span class=\"toggle-dot\"><\/span> Detect language\n      <\/label>\n      <label class=\"toggle-chip\">\n        <input type=\"checkbox\" id=\"optLabels\" checked>\n        <span class=\"toggle-dot\"><\/span> Turn labels\n      <\/label>\n    <\/div>\n  <\/div>\n\n  <div class=\"status-bar\" id=\"statusBar\">\n    <div class=\"spinner\"><\/div>\n    <div class=\"status-text\">\n      <span class=\"status-step\" id=\"statusStep\">INIT<\/span>\n      <span id=\"statusMsg\"> — Starting...<\/span>\n    <\/div>\n  <\/div>\n\n  <div class=\"error-box\" id=\"errorBox\"><\/div>\n\n  <div class=\"stats-row\" id=\"statsRow\"><\/div>\n\n  <div class=\"output-card\" id=\"outputCard\">\n    <div class=\"output-header\">\n      <span class=\"output-title\">OUTPUT \/\/ MARKDOWN<\/span>\n      <div class=\"output-actions\">\n        <button class=\"btn btn-secondary\" id=\"copyBtn\" onclick=\"copyMd()\">⎘ Copy<\/button>\n        <button class=\"btn btn-secondary\" onclick=\"downloadMd()\">↓ Download<\/button>\n      <\/div>\n    <\/div>\n    <textarea id=\"output\" spellcheck=\"false\" readonly><\/textarea>\n  <\/div>\n\n  <div class=\"steps\">\n    <div class=\"step\">\n      <div class=\"step-num\">01 \/\/ FETCH<\/div>\n      <div class=\"step-title\">Paste URL<\/div>\n      <div class=\"step-desc\">Any gemini.google.com\/share link works<\/div>\n    <\/div>\n    <div class=\"step\">\n      <div class=\"step-num\">02 \/\/ PARSE<\/div>\n      <div class=\"step-title\">Smart Parse<\/div>\n      <div class=\"step-desc\">Detects code, tables, inline snippets & language<\/div>\n    <\/div>\n    <div class=\"step\">\n      <div class=\"step-num\">03 \/\/ EXPORT<\/div>\n      <div class=\"step-title\">Get Markdown<\/div>\n      <div class=\"step-desc\">Copy to clipboard or download as .md file<\/div>\n    <\/div>\n  <\/div>\n\n<\/div>\n\n<script>\n\/\/ ─── Language Detection ───────────────────────────────────────────────────────\nconst LANG_PATTERNS = [\n  { lang: 'python',     re: \/\\b(def |import |from .+ import|print\\(|elif |lambda |self\\.|__init__)\/ },\n  { lang: 'javascript', re: \/\\b(const |let |var |=>|async |await |require\\(|module\\.exports|console\\.)\/ },\n  { lang: 'typescript', re: \/\\b(interface |type |enum |readonly |as |implements |<T>|: string|: number|: boolean)\/ },\n  { lang: 'jsx',        re: \/(<[A-Z][A-Za-z]+[\\s\/>]|return \\([\\s\\S]*<|useState|useEffect|React\\.)\/ },\n  { lang: 'html',       re: \/<!DOCTYPE html|<html|<head>|<body|<div|<span|<p>|<a href\/ },\n  { lang: 'css',        re: \/\\{[\\s\\S]*:\\s*[^;{}]+;[\\s\\S]*\\}|@media|@keyframes|\\.[\\w-]+\\s*\\{\/ },\n  { lang: 'sql',        re: \/\\b(SELECT |INSERT |UPDATE |DELETE |FROM |WHERE |JOIN |CREATE TABLE|ALTER |DROP )\/i },\n  { lang: 'bash',       re: \/^(#!\\\/bin\\\/|sudo |apt-get |npm |pip |git |chmod |mkdir |echo |cd |ls )|\\$\\s\/ },\n  { lang: 'json',       re: \/^\\s*[\\[{][\\s\\S]*[\\]}]\\s*$\/ },\n  { lang: 'yaml',       re: \/^[\\w-]+:\\s*\\n|^-\\s+\\w+:|^\\s{2,}[\\w-]+:\\s\/ },\n  { lang: 'rust',       re: \/\\b(fn |let mut |impl |pub struct |use std::|Result<|Option<|match |println!)\/ },\n  { lang: 'go',         re: \/\\b(func |package |import \\(|:=|fmt\\.|go |defer |goroutine)\/ },\n  { lang: 'java',       re: \/\\b(public class |private |protected |void |System\\.out|new [A-Z]|@Override)\/ },\n  { lang: 'c',          re: \/\\b(#include|printf\\(|scanf\\(|malloc\\(|int main\\(|->|NULL)\/ },\n  { lang: 'cpp',        re: \/\\b(#include <iostream>|std::|cout|cin|endl|vector<|nullptr|template<)\/ },\n  { lang: 'ruby',       re: \/\\b(def |end\\b|puts |attr_|require '|do \\||\\.each|class .* < )\/ },\n  { lang: 'php',        re: \/<\\?php|\\$\\w+\\s*=|echo |->|\\barray\\(|function \\w+\\s*\\(\/ },\n  { lang: 'swift',      re: \/\\b(var |let |func |guard |import Foundation|@IBOutlet|@State|struct .+: View)\/ },\n  { lang: 'kotlin',     re: \/\\b(fun |val |var |data class |companion object|->|?.|\\?\\.)\/ },\n  { lang: 'r',          re: \/\\b(library\\(|<-|data\\.frame|ggplot|dplyr|c\\(|lm\\(|summary\\()\/ },\n  { lang: 'matlab',     re: \/\\b(function |end\\b|fprintf|figure\\(|plot\\(|zeros\\(|ones\\(|matrix)\/ },\n  { lang: 'markdown',   re: \/^#+\\s|^\\*\\*|^-{3,}|^\\[.+\\]\\(.+\\)|^>\\s\/ },\n  { lang: 'dockerfile', re: \/^(FROM |RUN |CMD |EXPOSE |ENV |COPY |ADD |WORKDIR |ENTRYPOINT )\/ },\n  { lang: 'toml',       re: \/^\\[[\\w.]+\\]|^\\w+ = (\"|'|\\d|\\[)\/ },\n];\n\nfunction detectLang(code) {\n  const trimmed = code.trim();\n  for (const { lang, re } of LANG_PATTERNS) {\n    if (re.test(trimmed)) return lang;\n  }\n  return '';\n}\n\n\/\/ ─── HTML → Markdown converter ────────────────────────────────────────────────\nfunction htmlToMarkdown(html, opts) {\n  const div = document.createElement('div');\n  div.innerHTML = html;\n  return nodeToMd(div, opts).trim();\n}\n\nfunction nodeToMd(node, opts, depth = 0) {\n  if (node.nodeType === 3) return node.textContent; \/\/ text node\n  if (node.nodeType !== 1) return '';\n\n  const tag = node.tagName?.toLowerCase();\n  const children = () => Array.from(node.childNodes).map(c => nodeToMd(c, opts, depth)).join('');\n\n  switch (tag) {\n    case 'h1': return `\\n# ${children()}\\n`;\n    case 'h2': return `\\n## ${children()}\\n`;\n    case 'h3': return `\\n### ${children()}\\n`;\n    case 'h4': return `\\n#### ${children()}\\n`;\n    case 'h5': return `\\n##### ${children()}\\n`;\n    case 'h6': return `\\n###### ${children()}\\n`;\n\n    case 'p': return `\\n${children()}\\n`;\n    case 'br': return '\\n';\n\n    case 'strong':\n    case 'b': return `**${children()}**`;\n\n    case 'em':\n    case 'i': return `*${children()}*`;\n\n    case 's':\n    case 'del': return `~~${children()}~~`;\n\n    case 'a': {\n      const href = node.getAttribute('href') || '';\n      return `[${children()}](${href})`;\n    }\n\n    case 'img': {\n      const alt = node.getAttribute('alt') || '';\n      const src = node.getAttribute('src') || '';\n      return `![${alt}](${src})`;\n    }\n\n    case 'code': {\n      \/\/ inline code\n      if (opts.inline && node.closest && !node.closest('pre')) {\n        return `\\`${node.textContent}\\``;\n      }\n      return node.textContent;\n    }\n\n    case 'pre': {\n      if (!opts.code) return node.textContent;\n      const codeEl = node.querySelector('code');\n      const raw = (codeEl || node).textContent;\n      let lang = '';\n      if (opts.lang) {\n        \/\/ try class first (e.g. class=\"language-python\")\n        const cls = (codeEl || node).className || '';\n        const m = cls.match(\/language-(\\w+)\/);\n        lang = m ? m[1] : detectLang(raw);\n      }\n      return `\\n\\`\\`\\`${lang}\\n${raw.trim()}\\n\\`\\`\\`\\n`;\n    }\n\n    case 'ul': {\n      return '\\n' + Array.from(node.children).map(li =>\n        `- ${nodeToMd(li, opts, depth).trim()}`\n      ).join('\\n') + '\\n';\n    }\n\n    case 'ol': {\n      return '\\n' + Array.from(node.children).map((li, i) =>\n        `${i + 1}. ${nodeToMd(li, opts, depth).trim()}`\n      ).join('\\n') + '\\n';\n    }\n\n    case 'li': return children();\n\n    case 'blockquote': return '\\n' + children().trim().split('\\n').map(l => `> ${l}`).join('\\n') + '\\n';\n\n    case 'hr': return '\\n---\\n';\n\n    case 'table': {\n      if (!opts.tables) return children();\n      return parseTable(node);\n    }\n\n    default: return children();\n  }\n}\n\nfunction parseTable(table) {\n  const rows = Array.from(table.querySelectorAll('tr'));\n  if (!rows.length) return '';\n\n  const getCells = row => Array.from(row.querySelectorAll('th, td')).map(c => c.innerText.trim().replace(\/\\|\/g, '\\\\|'));\n\n  const headerCells = getCells(rows[0]);\n  const sep = headerCells.map(() => '---');\n  const bodyRows = rows.slice(1).map(getCells);\n\n  const fmt = cells => `| ${cells.join(' | ')} |`;\n  return '\\n' + [fmt(headerCells), fmt(sep), ...bodyRows.map(fmt)].join('\\n') + '\\n';\n}\n\n\/\/ ─── Inline code detection (post-process plain text) ─────────────────────────\nfunction wrapInlineCode(text) {\n  \/\/ Wrap things that look like code but weren't in <code> tags\n  return text\n    .replace(\/(?<![`\\w])((?:[a-zA-Z_$][\\w$]*\\.)+[a-zA-Z_$][\\w$]*(?:\\(.*?\\))?)(?![`\\w])\/g, '`$1`') \/\/ method.chains()\n    .replace(\/(?<![`])\\b([A-Z_]{3,})\\b(?![`])\/g, (m) => `\\`${m}\\``); \/\/ CONSTANTS\n}\n\n\/\/ ─── Core parser: extract turns from fetched HTML ────────────────────────────\nfunction parseGeminiHtml(rawHtml, opts) {\n  const parser = new DOMParser();\n  const doc = parser.parseFromString(rawHtml, 'text\/html');\n\n  \/\/ Stats trackers\n  let stats = { turns: 0, codeBlocks: 0, tables: 0, inlineCode: 0 };\n\n  \/\/ Try to get title\n  const title = doc.querySelector('h1')?.innerText?.trim()\n    || doc.querySelector('title')?.textContent?.trim()\n    || 'Gemini Conversation';\n\n  let md = `# ${title}\\n\\n`;\n  md += `> Exported via Gemini→MD converter\\n\\n---\\n\\n`;\n\n  \/\/ Candidate selectors for conversation turns\n  const turnSelectors = [\n    '[class*=\"conversation-turn\"]',\n    '[class*=\"message\"]',\n    '[class*=\"turn\"]',\n    '[class*=\"response\"]',\n    '[class*=\"query\"]',\n    'article',\n    '[role=\"article\"]',\n    '[class*=\"human\"]',\n    '[class*=\"model\"]',\n    '[class*=\"user\"]',\n    '[class*=\"assistant\"]',\n  ];\n\n  let turns = [];\n  for (const sel of turnSelectors) {\n    const found = doc.querySelectorAll(sel);\n    if (found.length >= 2) {\n      turns = Array.from(found);\n      break;\n    }\n  }\n\n  \/\/ Fallback: grab all major content blocks\n  if (!turns.length) {\n    turns = Array.from(doc.querySelectorAll('main p, main li, main pre, main table, main h2, main h3, main h4'));\n  }\n\n  if (!turns.length) {\n    \/\/ Last resort: entire body\n    turns = [doc.body];\n  }\n\n  const seen = new Set();\n\n  turns.forEach((el, i) => {\n    const rawInner = el.innerHTML;\n    if (!rawInner || rawInner.trim().length < 5) return;\n\n    const key = el.innerText?.trim().slice(0, 80);\n    if (seen.has(key)) return;\n    seen.add(key);\n\n    \/\/ Detect role\n    const cls = (el.className || '').toLowerCase() + ' ' + (el.getAttribute('data-role') || '');\n    const isUser = \/user|human|query|prompt\/.test(cls);\n    const isModel = \/model|gemini|response|assistant\/.test(cls);\n\n    let label = '';\n    if (opts.labels) {\n      if (isUser) label = '### 🧑 User\\n\\n';\n      else if (isModel) label = '### ✦ Gemini\\n\\n';\n      else label = i % 2 === 0 ? '### 🧑 User\\n\\n' : '### ✦ Gemini\\n\\n';\n    }\n\n    \/\/ Count pre\/code before conversion\n    stats.codeBlocks += el.querySelectorAll('pre').length;\n    stats.tables += el.querySelectorAll('table').length;\n    stats.inlineCode += el.querySelectorAll('code:not(pre code)').length;\n\n    let converted = htmlToMarkdown(rawInner, opts);\n\n    \/\/ Clean up excessive blank lines\n    converted = converted.replace(\/\\n{4,}\/g, '\\n\\n\\n').trim();\n\n    if (converted.length > 5) {\n      md += label + converted + '\\n\\n---\\n\\n';\n      stats.turns++;\n    }\n  });\n\n  return { md, title, stats };\n}\n\n\/\/ ─── Main convert function ────────────────────────────────────────────────────\nlet lastTitle = 'gemini-export';\n\nasync function convert() {\n  const url = document.getElementById('urlInput').value.trim();\n  if (!url) return showError('Please enter a Gemini share URL.');\n  if (!url.includes('gemini.google.com')) return showError('URL must be a gemini.google.com share link.');\n\n  const opts = {\n    code:   document.getElementById('optCode').checked,\n    inline: document.getElementById('optInline').checked,\n    tables: document.getElementById('optTables').checked,\n    lang:   document.getElementById('optLang').checked,\n    labels: document.getElementById('optLabels').checked,\n  };\n\n  clearState();\n  setStatus('FETCH', 'Requesting page via CORS proxy...');\n  document.getElementById('convertBtn').disabled = true;\n\n  try {\n    const proxyUrl = `https:\/\/api.allorigins.win\/get?url=${encodeURIComponent(url)}`;\n    setStatus('FETCH', 'Connecting to allorigins proxy...');\n\n    const res = await fetch(proxyUrl);\n    if (!res.ok) throw new Error(`HTTP ${res.status} from proxy`);\n\n    const json = await res.json();\n    const rawHtml = json.contents;\n\n    if (!rawHtml || rawHtml.length < 200) throw new Error('Empty or invalid response from proxy. The share link may be private or expired.');\n\n    setStatus('PARSE', 'Parsing HTML structure...');\n    await sleep(200);\n\n    const { md, title, stats } = parseGeminiHtml(rawHtml, opts);\n    lastTitle = title.replace(\/[^a-z0-9]\/gi, '_').toLowerCase() || 'gemini_export';\n\n    setStatus('DONE', 'Conversion complete!');\n    await sleep(300);\n\n    showOutput(md, stats);\n\n  } catch (err) {\n    showError(`${err.message}`);\n  } finally {\n    document.getElementById('convertBtn').disabled = false;\n    document.getElementById('statusBar').classList.remove('active');\n  }\n}\n\n\/\/ ─── UI helpers ───────────────────────────────────────────────────────────────\nfunction setStatus(step, msg) {\n  document.getElementById('statusBar').classList.add('active');\n  document.getElementById('statusStep').textContent = step;\n  document.getElementById('statusMsg').textContent = ` — ${msg}`;\n}\n\nfunction showError(msg) {\n  const box = document.getElementById('errorBox');\n  box.textContent = `⚠ Error: ${msg}`;\n  box.classList.add('active');\n  document.getElementById('statusBar').classList.remove('active');\n}\n\nfunction clearState() {\n  document.getElementById('errorBox').classList.remove('active');\n  document.getElementById('outputCard').classList.remove('active');\n  document.getElementById('statsRow').classList.remove('active');\n  document.getElementById('statsRow').innerHTML = '';\n}\n\nfunction showOutput(md, stats) {\n  document.getElementById('output').value = md;\n  document.getElementById('outputCard').classList.add('active');\n\n  const row = document.getElementById('statsRow');\n  row.innerHTML = `\n    <div class=\"stat-chip\"><span class=\"stat-num\">${stats.turns}<\/span><span class=\"stat-label\">turns<\/span><\/div>\n    <div class=\"stat-chip\"><span class=\"stat-num\">${stats.codeBlocks}<\/span><span class=\"stat-label\">code blocks<\/span><\/div>\n    <div class=\"stat-chip\"><span class=\"stat-num\">${stats.tables}<\/span><span class=\"stat-label\">tables<\/span><\/div>\n    <div class=\"stat-chip\"><span class=\"stat-num\">${stats.inlineCode}<\/span><span class=\"stat-label\">inline code<\/span><\/div>\n    <div class=\"stat-chip\"><span class=\"stat-num\">${md.length.toLocaleString()}<\/span><span class=\"stat-label\">chars<\/span><\/div>\n  `;\n  row.classList.add('active');\n}\n\nfunction copyMd() {\n  const ta = document.getElementById('output');\n  navigator.clipboard.writeText(ta.value).then(() => {\n    const btn = document.getElementById('copyBtn');\n    btn.classList.add('copy-flash');\n    btn.textContent = '✓ Copied!';\n    setTimeout(() => { btn.classList.remove('copy-flash'); btn.textContent = '⎘ Copy'; }, 1800);\n  });\n}\n\nfunction downloadMd() {\n  const md = document.getElementById('output').value;\n  const blob = new Blob([md], { type: 'text\/markdown' });\n  const a = document.createElement('a');\n  a.href = URL.createObjectURL(blob);\n  a.download = `${lastTitle}.md`;\n  a.click();\n  URL.revokeObjectURL(a.href);\n}\n\nfunction sleep(ms) { return new Promise(r => setTimeout(r, ms)); }\n\n\/\/ Enter key shortcut\ndocument.getElementById('urlInput').addEventListener('keydown', e => {\n  if (e.key === 'Enter') convert();\n});\n<\/script>\n<\/body>\n<\/html>\n"}