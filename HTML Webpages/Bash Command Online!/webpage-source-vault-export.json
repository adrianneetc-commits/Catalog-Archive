  {
    "id": "t_1789057537973_b26d28",
    "name": "Terminal Code Snippets",
    "desc": "Interactive dashboard for terminal and a-Shell commands.",
    "category": "dashboards",
    "tags": [
      "v2",
      "terminal",
      "shell"
    ],
    "created": 1789034752670,
    "currentVersionId": "v1",
    "thumbData": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>cmdvault</title>\n<style>\n  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');\n\n  :root{\n    --bg: #0b0d0a;\n    --bg-raised: #14170f;\n    --bg-inset: #080906;\n    --line: #2a2e1f;\n    --amber: #ffb000;\n    --amber-dim: #8a6200;\n    --amber-faint: #4a3a10;\n    --text: #e8dcc0;\n    --text-dim: #8a8570;\n    --danger: #ff5f4d;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    margin: 0; padding: 0;\n    background: var(--bg);\n    color: var(--text);\n    font-family: 'Inter', sans-serif;\n    height: 100%;\n  }\n\n  body {\n    background-image:\n      repeating-linear-gradient(0deg, rgba(255,176,0,0.015) 0px, rgba(255,176,0,0.015) 1px, transparent 1px, transparent 3px);\n  }\n\n  ::selection { background: var(--amber); color: #000; }\n\n  /* Scrollbar */\n  ::-webkit-scrollbar { width: 10px; }\n  ::-webkit-scrollbar-track { background: var(--bg-inset); }\n  ::-webkit-scrollbar-thumb { background: var(--amber-faint); border-radius: 0; }\n  ::-webkit-scrollbar-thumb:hover { background: var(--amber-dim); }\n\n  .shell {\n    display: flex;\n    flex-direction: column;\n    min-height: 100vh;\n  }\n\n  /* Top bar */\n  .topbar {\n    display: flex;\n    align-items: center;\n    gap: 16px;\n    padding: 14px 20px;\n    border-bottom: 1px solid var(--line);\n    background: var(--bg-raised);\n    flex-wrap: wrap;\n  }\n\n  .brand {\n    font-family: 'JetBrains Mono', monospace;\n    font-weight: 700;\n    font-size: 15px;\n    color: var(--amber);\n    letter-spacing: 0.5px;\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    white-space: nowrap;\n  }\n  .brand .cursor {\n    display: inline-block;\n    width: 8px; height: 16px;\n    background: var(--amber);\n    animation: blink 1.1s steps(1) infinite;\n  }\n  @keyframes blink { 50% { opacity: 0; } }\n\n  .search-wrap {\n    flex: 1;\n    min-width: 180px;\n    position: relative;\n  }\n  .search-wrap:before {\n    content: '/';\n    position: absolute;\n    left: 12px; top: 50%; transform: translateY(-50%);\n    color: var(--text-dim);\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n  }\n  #search {\n    width: 100%;\n    background: var(--bg-inset);\n    border: 1px solid var(--line);\n    color: var(--text);\n    padding: 9px 12px 9px 26px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    outline: none;\n  }\n  #search:focus { border-color: var(--amber-dim); }\n  #search::placeholder { color: var(--text-dim); }\n\n  .btn {\n    font-family: 'Inter', sans-serif;\n    font-weight: 600;\n    font-size: 13px;\n    background: transparent;\n    border: 1px solid var(--line);\n    color: var(--text);\n    padding: 9px 14px;\n    cursor: pointer;\n    white-space: nowrap;\n    transition: border-color .15s, color .15s, background .15s;\n  }\n  .btn:hover { border-color: var(--amber-dim); color: var(--amber); }\n  .btn:focus-visible { outline: 2px solid var(--amber); outline-offset: 2px; }\n  .btn-solid {\n    background: var(--amber);\n    border-color: var(--amber);\n    color: #1a1300;\n  }\n  .btn-solid:hover { background: #ffc233; color: #1a1300; border-color: #ffc233; }\n  .btn-ghost-danger:hover { border-color: var(--danger); color: var(--danger); }\n\n  input[type=file] { display: none; }\n\n  /* Layout */\n  .main {\n    flex: 1;\n    display: flex;\n    min-height: 0;\n  }\n\n  .sidebar {\n    width: 210px;\n    flex-shrink: 0;\n    border-right: 1px solid var(--line);\n    background: var(--bg-raised);\n    padding: 16px 0;\n    overflow-y: auto;\n  }\n  .sidebar-label {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    color: var(--text-dim);\n    text-transform: uppercase;\n    letter-spacing: 1px;\n    padding: 0 16px 8px;\n  }\n  .cat-item {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    padding: 8px 16px;\n    cursor: pointer;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: var(--text-dim);\n    border-left: 2px solid transparent;\n  }\n  .cat-item:hover { color: var(--text); background: rgba(255,176,0,0.04); }\n  .cat-item.active {\n    color: var(--amber);\n    border-left-color: var(--amber);\n    background: rgba(255,176,0,0.06);\n  }\n  .cat-count {\n    font-size: 11px;\n    color: var(--text-dim);\n    background: var(--bg-inset);\n    padding: 1px 6px;\n    border: 1px solid var(--line);\n  }\n  .cat-item.active .cat-count { color: var(--amber); border-color: var(--amber-faint); }\n\n  .content {\n    flex: 1;\n    overflow-y: auto;\n    padding: 0;\n  }\n\n  .empty-state {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    height: 100%;\n    color: var(--text-dim);\n    font-family: 'JetBrains Mono', monospace;\n    padding: 60px 20px;\n    text-align: center;\n  }\n  .empty-state .glyph { font-size: 28px; color: var(--amber-faint); margin-bottom: 12px; }\n\n  .cmd-row {\n    display: grid;\n    grid-template-columns: 44px 1fr auto;\n    gap: 0;\n    border-bottom: 1px solid var(--line);\n    align-items: stretch;\n  }\n  .cmd-row:hover { background: rgba(255,176,0,0.03); }\n\n  .lineno {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    color: var(--amber-dim);\n    text-align: right;\n    padding: 14px 10px 14px 0;\n    user-select: none;\n    border-right: 1px solid var(--line);\n  }\n\n  .cmd-body { padding: 12px 16px; min-width: 0; }\n  .cmd-top { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin-bottom: 4px; }\n  .cmd-name { font-weight: 600; font-size: 14px; color: var(--text); }\n  .cmd-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10.5px;\n    color: var(--amber);\n    background: rgba(255,176,0,0.08);\n    border: 1px solid var(--amber-faint);\n    padding: 1px 7px;\n    text-transform: lowercase;\n  }\n  .tag-badges { display: flex; gap: 5px; flex-wrap: wrap; }\n  .badge-tag {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 10.5px;\n    color: var(--text-dim);\n    background: var(--bg-inset);\n    border: 1px solid var(--line);\n    padding: 1px 7px;\n    text-transform: lowercase;\n  }\n  .badge-tag:before { content: '#'; color: var(--amber-dim); margin-right: 1px; }\n  .cmd-line {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    color: var(--text);\n    background: var(--bg-inset);\n    border: 1px solid var(--line);\n    padding: 8px 10px;\n    margin-top: 6px;\n    white-space: pre-wrap;\n    word-break: break-all;\n    position: relative;\n  }\n  .cmd-line:before { content: '$ '; color: var(--amber); }\n  .cmd-notes { font-size: 12.5px; color: var(--text-dim); margin-top: 6px; }\n\n  .cmd-actions {\n    display: flex;\n    align-items: flex-start;\n    gap: 6px;\n    padding: 12px 16px 12px 8px;\n  }\n  .icon-btn {\n    background: transparent;\n    border: 1px solid var(--line);\n    color: var(--text-dim);\n    width: 30px; height: 30px;\n    display: flex; align-items: center; justify-content: center;\n    cursor: pointer;\n    font-size: 13px;\n    flex-shrink: 0;\n  }\n  .icon-btn:hover { border-color: var(--amber-dim); color: var(--amber); }\n  .icon-btn.danger:hover { border-color: var(--danger); color: var(--danger); }\n  .icon-btn.copied { border-color: var(--amber); color: var(--amber); background: rgba(255,176,0,0.1); }\n  .icon-btn.running { border-color: var(--amber); color: var(--amber); animation: pulse 0.8s infinite; }\n  .icon-btn.ok { border-color: #7dd07d; color: #7dd07d; }\n  .icon-btn.err { border-color: var(--danger); color: var(--danger); }\n  @keyframes pulse { 50% { opacity: 0.4; } }\n\n  /* Runner status */\n  .runner-status {\n    display: flex;\n    align-items: center;\n    gap: 7px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11.5px;\n    color: var(--text-dim);\n    cursor: pointer;\n    padding: 8px 10px;\n    border: 1px solid var(--line);\n    white-space: nowrap;\n    background: transparent;\n  }\n  .runner-status:hover { border-color: var(--amber-dim); }\n  .runner-dot {\n    width: 7px; height: 7px;\n    border-radius: 50%;\n    background: var(--text-dim);\n    flex-shrink: 0;\n  }\n  .runner-status.connected .runner-dot { background: #7dd07d; box-shadow: 0 0 5px #7dd07d; }\n  .runner-status.connected { color: #7dd07d; border-color: #2e5a2e; }\n\n  /* Per-line layout */\n  .cmd-line-row {\n    display: flex;\n    align-items: stretch;\n    gap: 6px;\n    margin-top: 6px;\n  }\n  .cmd-line { flex: 1; margin-top: 0; cursor: default; }\n  .line-btn-group { display: flex; gap: 4px; flex-shrink: 0; }\n  .line-btn {\n    background: transparent;\n    border: 1px solid var(--line);\n    color: var(--text-dim);\n    width: 34px;\n    font-size: 12px;\n    cursor: pointer;\n  }\n  .line-btn:hover { border-color: var(--amber-dim); color: var(--amber); }\n  .line-btn.run-btn:hover { border-color: #7dd07d; color: #7dd07d; }\n\n  .output-block {\n    margin-top: 4px;\n    background: #050603;\n    border: 1px solid var(--line);\n    border-left: 2px solid var(--amber-dim);\n    padding: 8px 10px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 12px;\n    white-space: pre-wrap;\n    word-break: break-word;\n    position: relative;\n    max-height: 220px;\n    overflow-y: auto;\n  }\n  .output-block.err { border-left-color: var(--danger); }\n  .output-block .out-head {\n    display: flex; justify-content: space-between; align-items: center;\n    color: var(--text-dim); margin-bottom: 4px; font-size: 11px;\n  }\n  .output-block .out-close { cursor: pointer; color: var(--text-dim); }\n  .output-block .out-close:hover { color: var(--amber); }\n  .output-stdout { color: var(--text); }\n  .output-stderr { color: #ff8a7a; }\n\n  /* Modal */\n  .modal-overlay {\n    position: fixed; inset: 0;\n    background: rgba(0,0,0,0.7);\n    display: none;\n    align-items: center; justify-content: center;\n    z-index: 50;\n    padding: 20px;\n  }\n  .modal-overlay.open { display: flex; }\n  .modal {\n    background: var(--bg-raised);\n    border: 1px solid var(--amber-faint);\n    width: 100%; max-width: 480px;\n    max-height: 90vh;\n    overflow-y: auto;\n  }\n  .modal.resizable {\n    resize: both;\n    overflow: auto;\n    min-width: 340px;\n    min-height: 280px;\n    position: relative;\n    flex-shrink: 0;\n  }\n  .resize-hint {\n    position: absolute;\n    bottom: 4px; right: 5px;\n    font-size: 10px;\n    color: var(--text-dim);\n    pointer-events: none;\n    letter-spacing: 1px;\n    opacity: 0.6;\n  }\n  .modal-head {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 16px 18px;\n    border-bottom: 1px solid var(--line);\n  }\n  .modal-head h2 {\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 14px;\n    color: var(--amber);\n    margin: 0;\n    font-weight: 600;\n  }\n  .modal-close {\n    background: none; border: none; color: var(--text-dim);\n    cursor: pointer; font-size: 18px; line-height: 1;\n  }\n  .modal-close:hover { color: var(--amber); }\n  .modal-body { padding: 18px; display: flex; flex-direction: column; gap: 14px; }\n  .field label {\n    display: block;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 11px;\n    color: var(--text-dim);\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    margin-bottom: 6px;\n  }\n  .field input, .field textarea, .field select {\n    width: 100%;\n    background: var(--bg-inset);\n    border: 1px solid var(--line);\n    color: var(--text);\n    padding: 9px 10px;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    outline: none;\n    resize: vertical;\n  }\n  .field textarea { min-height: 70px; line-height: 1.5; }\n  .field input:focus, .field textarea:focus, .field select:focus { border-color: var(--amber-dim); }\n  .field-hint { font-size: 11.5px; color: var(--text-dim); margin-top: 5px; }\n  .modal-foot {\n    display: flex; justify-content: flex-end; gap: 8px;\n    padding: 14px 18px; border-top: 1px solid var(--line);\n  }\n\n  .toast {\n    position: fixed;\n    bottom: 20px; left: 50%;\n    transform: translateX(-50%) translateY(20px);\n    background: var(--amber);\n    color: #1a1300;\n    font-family: 'JetBrains Mono', monospace;\n    font-size: 13px;\n    font-weight: 600;\n    padding: 10px 18px;\n    opacity: 0;\n    pointer-events: none;\n    transition: opacity .2s, transform .2s;\n    z-index: 100;\n  }\n  .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }\n\n  @media (max-width: 640px) {\n    .sidebar { display: none; }\n    .cmd-row { grid-template-columns: 30px 1fr auto; }\n    .cmd-actions { flex-direction: column; }\n  }\n</style>\n</head>\n<body>\n<div class=\"shell\">\n  <div class=\"topbar\">\n    <div class=\"brand\"><span class=\"cursor\"></span>cmdvault</div>\n    <div class=\"search-wrap\">\n      <input id=\"search\" type=\"text\" placeholder=\"filter commands...\">\n    </div>\n    <button class=\"btn\" id=\"uploadBtn\">upload</button>\n    <input type=\"file\" id=\"fileInput\" accept=\".txt,.sh,.json\">\n    <button class=\"btn\" id=\"exportBtn\">export</button>\n    <button class=\"runner-status\" id=\"runnerStatus\" title=\"click to configure the local runner\">\n      <span class=\"runner-dot\"></span><span id=\"runnerStatusText\">runner: off</span>\n    </button>\n    <button class=\"btn btn-solid\" id=\"addBtn\">+ add command</button>\n  </div>\n\n  <div class=\"main\">\n    <div class=\"sidebar\">\n      <div class=\"sidebar-label\">categories</div>\n      <div id=\"catList\"></div>\n    </div>\n    <div class=\"content\" id=\"content\"></div>\n  </div>\n</div>\n\n<div class=\"modal-overlay\" id=\"modalOverlay\">\n  <div class=\"modal resizable\">\n    <div class=\"modal-head\">\n      <h2 id=\"modalTitle\">add command</h2>\n      <button class=\"modal-close\" id=\"modalClose\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"field\">\n        <label>name</label>\n        <input id=\"fName\" type=\"text\" placeholder=\"e.g. list large files\">\n      </div>\n      <div class=\"field\">\n        <label>command (one per line = separate runnable lines)</label>\n        <textarea id=\"fCommand\" placeholder=\"find . -size +100M -exec ls -lh {} \\;\"></textarea>\n        <div class=\"field-hint\">multi-line commands get a copy button per line.</div>\n      </div>\n      <div class=\"field\">\n        <label>category</label>\n        <input id=\"fCategory\" type=\"text\" placeholder=\"e.g. git, docker, misc\" list=\"catOptions\">\n        <datalist id=\"catOptions\"></datalist>\n      </div>\n      <div class=\"field\">\n        <label>tags (comma separated)</label>\n        <input id=\"fTags\" type=\"text\" placeholder=\"e.g. cleanup, disk, cron\">\n      </div>\n      <div class=\"field\">\n        <label>notes (optional)</label>\n        <textarea id=\"fNotes\" placeholder=\"what this does, gotchas, flags...\" style=\"min-height:50px;\"></textarea>\n      </div>\n    </div>\n    <div class=\"modal-foot\">\n      <button class=\"btn\" id=\"cancelBtn\">cancel</button>\n      <button class=\"btn btn-solid\" id=\"saveBtn\">save</button>\n    </div>\n    <span class=\"resize-hint\">&#8600;</span>\n  </div>\n</div>\n\n<div class=\"modal-overlay\" id=\"runnerOverlay\">\n  <div class=\"modal\">\n    <div class=\"modal-head\">\n      <h2>runner settings</h2>\n      <button class=\"modal-close\" id=\"runnerModalClose\">&times;</button>\n    </div>\n    <div class=\"modal-body\">\n      <div class=\"field-hint\" style=\"margin-bottom:4px;\">\n        To actually execute commands (not just copy them), run the local helper\n        script on your machine: <code>python3 cmdvault-runner.py</code>.\n        It prints a token — paste it below, then connect. It only listens on\n        localhost, and only cmdvault (with the right token) can send it commands.\n      </div>\n      <div class=\"field\">\n        <label>runner url</label>\n        <input id=\"runnerUrl\" type=\"text\" placeholder=\"http://localhost:8765\">\n      </div>\n      <div class=\"field\">\n        <label>token</label>\n        <input id=\"runnerToken\" type=\"text\" placeholder=\"paste token printed by the script\">\n      </div>\n      <div class=\"field-hint\" id=\"runnerTestResult\"></div>\n    </div>\n    <div class=\"modal-foot\">\n      <button class=\"btn\" id=\"runnerDisconnectBtn\">disconnect</button>\n      <button class=\"btn btn-solid\" id=\"runnerConnectBtn\">connect</button>\n    </div>\n  </div>\n</div>\n\n<div class=\"toast\" id=\"toast\"></div>\n\n<script>\nconst STORAGE_KEY = 'commands';\nlet commands = [];\nlet activeCategory = 'all';\nlet editingId = null;\n\nconst contentEl = document.getElementById('content');\nconst catListEl = document.getElementById('catList');\nconst searchEl = document.getElementById('search');\nconst toastEl = document.getElementById('toast');\n\nfunction uid(){ return 'c_' + Date.now() + '_' + Math.random().toString(36).slice(2,8); }\n\nfunction showToast(msg){\n  toastEl.textContent = msg;\n  toastEl.classList.add('show');\n  clearTimeout(showToast._t);\n  showToast._t = setTimeout(()=> toastEl.classList.remove('show'), 1400);\n}\n\nasync function loadCommands(){\n  try {\n    const res = await window.storage.get(STORAGE_KEY, false);\n    commands = res ? JSON.parse(res.value) : [];\n  } catch(e){\n    commands = [];\n  }\n  render();\n}\n\nasync function persist(){\n  try {\n    await window.storage.set(STORAGE_KEY, JSON.stringify(commands), false);\n  } catch(e){\n    showToast('save failed — storage error');\n  }\n}\n\nfunction getCategories(){\n  const cats = new Set(commands.map(c => c.category || 'uncategorized'));\n  return Array.from(cats).sort();\n}\n\nfunction renderCategories(){\n  const cats = getCategories();\n  const counts = {};\n  commands.forEach(c => {\n    const k = c.category || 'uncategorized';\n    counts[k] = (counts[k]||0) + 1;\n  });\n  let html = `<div class=\"cat-item ${activeCategory==='all'?'active':''}\" data-cat=\"all\">\n    <span>all</span><span class=\"cat-count\">${commands.length}</span></div>`;\n  cats.forEach(cat => {\n    html += `<div class=\"cat-item ${activeCategory===cat?'active':''}\" data-cat=\"${escapeAttr(cat)}\">\n      <span>${escapeHtml(cat)}</span><span class=\"cat-count\">${counts[cat]}</span></div>`;\n  });\n  catListEl.innerHTML = html;\n  catListEl.querySelectorAll('.cat-item').forEach(el => {\n    el.addEventListener('click', () => {\n      activeCategory = el.dataset.cat;\n      render();\n    });\n  });\n\n  // update datalist for the modal\n  const datalist = document.getElementById('catOptions');\n  datalist.innerHTML = cats.map(c => `<option value=\"${escapeAttr(c)}\">`).join('');\n}\n\nfunction escapeHtml(str){\n  const d = document.createElement('div');\n  d.textContent = str || '';\n  return d.innerHTML;\n}\nfunction escapeAttr(str){\n  return (str||'').replace(/\"/g,'&quot;');\n}\n\nfunction filteredCommands(){\n  const q = searchEl.value.trim().toLowerCase();\n  return commands.filter(c => {\n    if (activeCategory !== 'all' && (c.category || 'uncategorized') !== activeCategory) return false;\n    if (!q) return true;\n    return (c.name||'').toLowerCase().includes(q) ||\n           (c.command||'').toLowerCase().includes(q) ||\n           (c.notes||'').toLowerCase().includes(q) ||\n           (c.category||'').toLowerCase().includes(q) ||\n           (c.tags||[]).some(t => t.toLowerCase().includes(q));\n  });\n}\n\nfunction render(){\n  renderCategories();\n  const list = filteredCommands();\n  if (list.length === 0){\n    contentEl.innerHTML = `<div class=\"empty-state\">\n      <div class=\"glyph\">&gt;_</div>\n      <div>${commands.length === 0 ? 'no commands saved yet' : 'nothing matches that filter'}</div>\n    </div>`;\n    return;\n  }\n  let html = '';\n  list.forEach((c, i) => {\n    const lines = (c.command||'').split('\\n').filter(l => l.trim().length);\n    const tags = c.tags || [];\n    html += `<div class=\"cmd-row\" data-id=\"${c.id}\">\n      <div class=\"lineno\">${String(i+1).padStart(2,'0')}</div>\n      <div class=\"cmd-body\">\n        <div class=\"cmd-top\">\n          <span class=\"cmd-name\">${escapeHtml(c.name || 'untitled')}</span>\n          <span class=\"cmd-tag\">${escapeHtml(c.category || 'uncategorized')}</span>\n          ${tags.length ? `<span class=\"tag-badges\">${tags.map(t => `<span class=\"badge-tag\">${escapeHtml(t)}</span>`).join('')}</span>` : ''}\n        </div>\n        ${lines.map((line, li) => `<div class=\"cmd-line-row\" data-line-row>\n            <div class=\"cmd-line\" data-line=\"${escapeAttr(line)}\">${escapeHtml(line)}</div>\n            <div class=\"line-btn-group\">\n              <button class=\"line-btn run-btn\" title=\"run this line\" data-cmdid=\"${c.id}\" data-line=\"${escapeAttr(line)}\">&#9658;</button>\n              <button class=\"line-btn copy-btn\" title=\"copy this line\" data-line=\"${escapeAttr(line)}\">&#10697;</button>\n            </div>\n          </div>\n          <div class=\"output-slot\" data-output-slot></div>`).join('')}\n        ${c.notes ? `<div class=\"cmd-notes\">${escapeHtml(c.notes)}</div>` : ''}\n      </div>\n      <div class=\"cmd-actions\">\n        <button class=\"icon-btn run-all-btn\" title=\"run all lines\" data-id=\"${c.id}\">&#9654;&#9654;</button>\n        <button class=\"icon-btn edit-btn\" title=\"edit\" data-id=\"${c.id}\">&#9998;</button>\n        <button class=\"icon-btn danger delete-btn\" title=\"delete\" data-id=\"${c.id}\">&#10005;</button>\n      </div>\n    </div>`;\n  });\n  contentEl.innerHTML = html;\n  attachRowEvents();\n}\n\nfunction attachRowEvents(){\n  contentEl.querySelectorAll('.copy-btn').forEach(btn => {\n    btn.addEventListener('click', () => copyText(btn.dataset.line, btn));\n  });\n  contentEl.querySelectorAll('.run-btn').forEach(btn => {\n    btn.addEventListener('click', () => runOne(btn.dataset.line, btn));\n  });\n  contentEl.querySelectorAll('.run-all-btn').forEach(btn => {\n    btn.addEventListener('click', () => {\n      const c = commands.find(x => x.id === btn.dataset.id);\n      if (!c) return;\n      runOne(c.command, btn);\n    });\n  });\n  contentEl.querySelectorAll('.edit-btn').forEach(btn => {\n    btn.addEventListener('click', () => openEdit(btn.dataset.id));\n  });\n  contentEl.querySelectorAll('.delete-btn').forEach(btn => {\n    btn.addEventListener('click', () => deleteCommand(btn.dataset.id));\n  });\n}\n\n// ---------- Runner (local execution) ----------\nlet runnerConfig = { url: 'http://localhost:8765', token: '', connected: false };\n\nasync function loadRunnerConfig(){\n  try {\n    const res = await window.storage.get('runner-config', false);\n    if (res) runnerConfig = { ...runnerConfig, ...JSON.parse(res.value) };\n  } catch(e){ /* no saved config yet */ }\n  if (runnerConfig.url && runnerConfig.token){\n    pingRunner();\n  } else {\n    updateRunnerStatus(false);\n  }\n}\n\nfunction updateRunnerStatus(connected){\n  runnerConfig.connected = connected;\n  const el = document.getElementById('runnerStatus');\n  const txt = document.getElementById('runnerStatusText');\n  el.classList.toggle('connected', connected);\n  txt.textContent = connected ? 'runner: connected' : 'runner: off';\n}\n\nasync function pingRunner(){\n  try {\n    const res = await fetch(runnerConfig.url.replace(/\\/$/,'') + '/ping', { method: 'GET' });\n    updateRunnerStatus(res.ok);\n    return res.ok;\n  } catch(e){\n    updateRunnerStatus(false);\n    return false;\n  }\n}\n\nasync function runOne(commandText, el){\n  if (!commandText || !commandText.trim()) return;\n\n  if (!runnerConfig.connected){\n    // fall back to copy, since there's no way to execute without the local runner\n    copyText(commandText, el);\n    showToast('runner not connected — copied instead (click \"runner: off\" to connect)');\n    return;\n  }\n\n  if (el) el.classList.add('running');\n  const outSlot = findOutputSlot(el);\n\n  try {\n    const res = await fetch(runnerConfig.url.replace(/\\/$/,'') + '/run', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ command: commandText, token: runnerConfig.token })\n    });\n    const data = await res.json();\n    if (el) el.classList.remove('running');\n\n    if (!res.ok){\n      if (el) el.classList.add('err');\n      showOutput(outSlot, { stdout: '', stderr: data.error || 'runner rejected the request (check token)', exit_code: -1 });\n      return;\n    }\n    if (el) el.classList.add(data.exit_code === 0 ? 'ok' : 'err');\n    setTimeout(() => el && el.classList.remove('ok','err'), 1200);\n    showOutput(outSlot, data);\n  } catch(e){\n    if (el){ el.classList.remove('running'); el.classList.add('err'); setTimeout(()=>el.classList.remove('err'),1200); }\n    updateRunnerStatus(false);\n    showOutput(outSlot, { stdout: '', stderr: 'could not reach the runner — is cmdvault-runner.py still running?', exit_code: -1 });\n  }\n}\n\nfunction findOutputSlot(el){\n  if (!el) return null;\n  const row = el.closest('.cmd-line-row') || el.closest('.cmd-actions');\n  if (!row) return null;\n  if (row.classList.contains('cmd-line-row')) return row.nextElementSibling;\n  // run-all button lives in .cmd-actions -> use the last output-slot in this cmd-body\n  const body = row.parentElement.querySelector('.cmd-body');\n  const slots = body ? body.querySelectorAll('.output-slot') : [];\n  return slots.length ? slots[slots.length - 1] : null;\n}\n\nfunction showOutput(slot, data){\n  if (!slot) return;\n  const isErr = data.exit_code !== 0;\n  slot.innerHTML = `<div class=\"output-block ${isErr ? 'err' : ''}\">\n    <div class=\"out-head\"><span>exit ${data.exit_code}</span><span class=\"out-close\">&times;</span></div>\n    ${data.stdout ? `<div class=\"output-stdout\">${escapeHtml(data.stdout)}</div>` : ''}\n    ${data.stderr ? `<div class=\"output-stderr\">${escapeHtml(data.stderr)}</div>` : ''}\n    ${(!data.stdout && !data.stderr) ? `<div class=\"output-stdout\" style=\"color:var(--text-dim)\">(no output)</div>` : ''}\n  </div>`;\n  slot.querySelector('.out-close').addEventListener('click', () => { slot.innerHTML = ''; });\n}\n\n// Runner settings modal\nconst runnerOverlay = document.getElementById('runnerOverlay');\ndocument.getElementById('runnerStatus').addEventListener('click', () => {\n  document.getElementById('runnerUrl').value = runnerConfig.url || 'http://localhost:8765';\n  document.getElementById('runnerToken').value = runnerConfig.token || '';\n  document.getElementById('runnerTestResult').textContent = '';\n  runnerOverlay.classList.add('open');\n});\ndocument.getElementById('runnerModalClose').addEventListener('click', () => runnerOverlay.classList.remove('open'));\nrunnerOverlay.addEventListener('click', (e) => { if (e.target === runnerOverlay) runnerOverlay.classList.remove('open'); });\n\ndocument.getElementById('runnerConnectBtn').addEventListener('click', async () => {\n  const url = document.getElementById('runnerUrl').value.trim() || 'http://localhost:8765';\n  const token = document.getElementById('runnerToken').value.trim();\n  runnerConfig.url = url;\n  runnerConfig.token = token;\n  const resultEl = document.getElementById('runnerTestResult');\n  resultEl.textContent = 'testing connection...';\n  const ok = await pingRunner();\n  if (ok){\n    resultEl.textContent = 'connected.';\n    try { await window.storage.set('runner-config', JSON.stringify({ url, token }), false); } catch(e){}\n    showToast('runner connected');\n    setTimeout(() => runnerOverlay.classList.remove('open'), 500);\n  } else {\n    resultEl.textContent = 'could not reach that address. Is cmdvault-runner.py running?';\n  }\n});\n\ndocument.getElementById('runnerDisconnectBtn').addEventListener('click', async () => {\n  runnerConfig = { url: runnerConfig.url, token: '', connected: false };\n  updateRunnerStatus(false);\n  try { await window.storage.set('runner-config', JSON.stringify({ url: runnerConfig.url, token: '' }), false); } catch(e){}\n  runnerOverlay.classList.remove('open');\n  showToast('runner disconnected');\n});\n\nasync function copyText(text, el){\n  try {\n    await navigator.clipboard.writeText(text);\n  } catch(e){\n    // fallback\n    const ta = document.createElement('textarea');\n    ta.value = text;\n    document.body.appendChild(ta);\n    ta.select();\n    document.execCommand('copy');\n    document.body.removeChild(ta);\n  }\n  showToast('copied — paste into your terminal to run');\n  if (el){\n    el.classList.add('copied');\n    setTimeout(()=> el.classList.remove('copied'), 900);\n  }\n}\n\nfunction deleteCommand(id){\n  if (!confirm('Delete this command?')) return;\n  commands = commands.filter(c => c.id !== id);\n  persist();\n  render();\n}\n\n// Modal handling\nconst overlay = document.getElementById('modalOverlay');\nconst modalTitle = document.getElementById('modalTitle');\nconst fName = document.getElementById('fName');\nconst fCommand = document.getElementById('fCommand');\nconst fCategory = document.getElementById('fCategory');\nconst fTags = document.getElementById('fTags');\nconst fNotes = document.getElementById('fNotes');\n\nfunction parseTags(str){\n  return (str || '').split(',').map(t => t.trim().toLowerCase()).filter(Boolean);\n}\n\nfunction openAdd(){\n  editingId = null;\n  modalTitle.textContent = 'add command';\n  fName.value = ''; fCommand.value = ''; fCategory.value = ''; fTags.value = ''; fNotes.value = '';\n  overlay.classList.add('open');\n  renderCategories();\n  setTimeout(()=> fName.focus(), 50);\n}\n\nfunction openEdit(id){\n  const c = commands.find(x => x.id === id);\n  if (!c) return;\n  editingId = id;\n  modalTitle.textContent = 'edit command';\n  fName.value = c.name || '';\n  fCommand.value = c.command || '';\n  fCategory.value = c.category || '';\n  fTags.value = (c.tags || []).join(', ');\n  fNotes.value = c.notes || '';\n  overlay.classList.add('open');\n  renderCategories();\n  setTimeout(()=> fName.focus(), 50);\n}\n\nfunction closeModal(){\n  overlay.classList.remove('open');\n}\n\ndocument.getElementById('addBtn').addEventListener('click', openAdd);\ndocument.getElementById('modalClose').addEventListener('click', closeModal);\ndocument.getElementById('cancelBtn').addEventListener('click', closeModal);\noverlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });\n\ndocument.getElementById('saveBtn').addEventListener('click', async () => {\n  const name = fName.value.trim();\n  const command = fCommand.value.trim();\n  if (!command){\n    showToast('command field is empty');\n    return;\n  }\n  const tags = parseTags(fTags.value);\n  if (editingId){\n    const c = commands.find(x => x.id === editingId);\n    c.name = name; c.command = command;\n    c.category = fCategory.value.trim() || 'uncategorized';\n    c.tags = tags;\n    c.notes = fNotes.value.trim();\n  } else {\n    commands.unshift({\n      id: uid(),\n      name: name || 'untitled',\n      command,\n      category: fCategory.value.trim() || 'uncategorized',\n      tags,\n      notes: fNotes.value.trim(),\n      created: Date.now()\n    });\n  }\n  await persist();\n  closeModal();\n  render();\n  showToast('saved');\n});\n\n\nsearchEl.addEventListener('input', render);\n\n// Upload\ndocument.getElementById('uploadBtn').addEventListener('click', () => {\n  document.getElementById('fileInput').click();\n});\n\ndocument.getElementById('fileInput').addEventListener('change', async (e) => {\n  const file = e.target.files[0];\n  if (!file) return;\n  const text = await file.text();\n  let imported = 0;\n\n  if (file.name.endsWith('.json')){\n    try {\n      const data = JSON.parse(text);\n      const arr = Array.isArray(data) ? data : (data.commands || []);\n      arr.forEach(item => {\n        if (item && item.command){\n          commands.unshift({\n            id: uid(),\n            name: item.name || 'untitled',\n            command: item.command,\n            category: item.category || 'imported',\n            notes: item.notes || '',\n            created: Date.now()\n          });\n          imported++;\n        }\n      });\n    } catch(err){\n      showToast('could not parse JSON file');\n      e.target.value = '';\n      return;\n    }\n  } else {\n    // .txt or .sh — each non-empty, non-comment line becomes a command\n    const lines = text.split('\\n').map(l => l.trim()).filter(l => l && !l.startsWith('#!'));\n    lines.forEach(line => {\n      commands.unshift({\n        id: uid(),\n        name: line.length > 40 ? line.slice(0,40) + '…' : line,\n        command: line,\n        category: 'imported',\n        notes: '',\n        created: Date.now()\n      });\n      imported++;\n    });\n  }\n\n  await persist();\n  render();\n  showToast(`imported ${imported} command${imported === 1 ? '' : 's'}`);\n  e.target.value = '';\n});\n\n// Export\ndocument.getElementById('exportBtn').addEventListener('click', () => {\n  const blob = new Blob([JSON.stringify(commands, null, 2)], { type: 'application/json' });\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = 'cmdvault-export.json';\n  document.body.appendChild(a);\n  a.click();\n  document.body.removeChild(a);\n  URL.revokeObjectURL(url);\n  showToast('exported');\n});\n\n// Keyboard: Escape closes modal, / focuses search\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();\n  if (e.key === '/' && document.activeElement !== searchEl && !overlay.classList.contains('open')){\n    e.preventDefault();\n    searchEl.focus();\n  }\n});\n\nloadCommands();\nloadRunnerConfig();\n</script>\n</body>\n</html>\n",
